@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}

<div class="rd-auth rd-auth-wide">
    <p class="rd-eyebrow mb-1">Join the field</p>
    <h1 class="mb-4">Create your <span class="text-primary">account</span></h1>

    <div class="rd-panel">
        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>

            <p class="form-label mb-2">I want to&hellip;</p>
            <div class="row g-3 mb-4">
                <div class="col-6 rd-role-choice">
                    <input type="radio" id="role-participant" name="Role" value="Participant" checked="@(Model.Role != "Organiser")" />
                    <label for="role-participant">Enter races<br /><small class="text-muted fw-normal">Participant</small></label>
                </div>
                <div class="col-6 rd-role-choice">
                    <input type="radio" id="role-organiser" name="Role" value="Organiser" checked="@(Model.Role == "Organiser")" />
                    <label for="role-organiser">Organise events<br /><small class="text-muted fw-normal">Organiser</small></label>
                </div>
            </div>
            <span asp-validation-for="Role" class="text-danger d-block mb-3"></span>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" autocomplete="name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
            </div>

            <div id="participant-fields" class="row g-3 mt-0">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
            </div>

            <div id="organiser-fields" class="row g-3 mt-0">
                <div class="col-md-6">
                    <label asp-for="OrganisationName" class="form-label"></label>
                    <input asp-for="OrganisationName" class="form-control" />
                    <span asp-validation-for="OrganisationName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactPhone" class="form-label"></label>
                    <input asp-for="ContactPhone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="ContactPhone" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary rd-btn-pill w-100 py-2 mt-4">Create account</button>
        </form>
    </div>

    <p class="text-center mt-3 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var radios = document.querySelectorAll('input[name="Role"]');
            var participant = document.getElementById('participant-fields');
            var organiser = document.getElementById('organiser-fields');
            function sync() {
                var isOrganiser = document.getElementById('role-organiser').checked;
                organiser.style.display = isOrganiser ? '' : 'none';
                participant.style.display = isOrganiser ? 'none' : '';
            }
            radios.forEach(function (r) { r.addEventListener('change', sync); });
            sync();
        })();
    </script>
}
