@model HomeViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var name = Context.Session.CurrentUser()?.Name ?? "";
    var firstName = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "runner";
}

<section class="rd-hero">
    <p class="rd-eyebrow text-white-50 mb-2">Hi @firstName</p>
    <h1 class="mb-2">Your next <span>start line</span> is waiting</h1>
    <p>Browse upcoming runs, walks and rides, pick your category and enrol in seconds.</p>
</section>

<form method="get" asp-action="Index" class="rd-panel mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-6 col-lg-3">
            <label for="type" class="form-label">Event type</label>
            <select id="type" name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var t in new[] { "Run", "Walk", "Cycle" })
                {
                    <option value="@t" selected="@(Model.Type == t)">@t</option>
                }
            </select>
        </div>
        <div class="col-6 col-lg-3">
            <label for="date" class="form-label">Date</label>
            <input id="date" name="date" type="date" class="form-control" value="@(Model.Date?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-12 col-lg-3">
            <label for="location" class="form-label">Location</label>
            <input id="location" name="location" class="form-control" placeholder="e.g. Durban" value="@Model.Location" />
        </div>
        <div class="col-12 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary rd-btn-pill flex-grow-1">Apply filters</button>
            @if (Model.HasFilters)
            {
                <a asp-action="Index" class="btn btn-outline-secondary rd-btn-pill">Clear</a>
            }
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="rd-empty rd-panel">
        <h3>@(Model.HasFilters ? "No events match those filters" : "No upcoming events yet")</h3>
        <p class="mb-0">@(Model.HasFilters ? "Try a different type, date or location." : "Check back soon, new events are added all the time.")</p>
    </div>
}
else
{
    <p class="text-muted mb-3">@Model.Events.Count @(Model.Events.Count == 1 ? "event" : "events") found</p>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col"><partial name="_EventCard" model="ev" /></div>
        }
    </div>
}
