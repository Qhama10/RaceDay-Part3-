@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "Create event";
}

<div class="rd-page-title">
    <div>
        <p class="rd-eyebrow mb-1">Organiser</p>
        <h1>@(Model.IsEdit ? "Edit event" : "Create event")</h1>
    </div>
    <a class="btn btn-outline-secondary rd-btn-pill" asp-action="Events">Cancel</a>
</div>

<div class="rd-panel">
    <form method="post" enctype="multipart/form-data" novalidate
          asp-action="@(Model.IsEdit ? "EditEvent" : "CreateEvent")"
          asp-route-id="@(Model.IsEdit ? Model.EventId : null)">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="EventName" class="form-label"></label>
                <input asp-for="EventName" class="form-control" />
                <span asp-validation-for="EventName" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    <option value="Run">Run</option>
                    <option value="Walk">Walk</option>
                    <option value="Cycle">Cycle</option>
                </select>
                <span asp-validation-for="EventType" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="EventDescription" class="form-label"></label>
                <textarea asp-for="EventDescription" class="form-control" rows="4"></textarea>
                <span asp-validation-for="EventDescription" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="EventDate" class="form-label"></label>
                <input asp-for="EventDate" type="date" class="form-control" />
                <span asp-validation-for="EventDate" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="EventLocation" class="form-label"></label>
                <input asp-for="EventLocation" class="form-control" />
                <span asp-validation-for="EventLocation" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Distance" class="form-label"></label>
                <input asp-for="Distance" type="number" step="0.01" min="0.01" max="9999.99" class="form-control" />
                <span asp-validation-for="Distance" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Banner" class="form-label"></label>
                <div class="row g-3 align-items-center">
                    @if (!string.IsNullOrWhiteSpace(Model.BannerUrl))
                    {
                        <div class="col-auto">
                            <img src="@Model.BannerUrl" alt="Current banner" id="banner-preview" style="height:90px;border-radius:.6rem;" />
                        </div>
                    }
                    else
                    {
                        <div class="col-auto">
                            <img alt="Banner preview" id="banner-preview" style="height:90px;border-radius:.6rem;display:none;" />
                        </div>
                    }
                    <div class="col">
                        <input asp-for="Banner" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" />
                        <div class="form-text">JPG, PNG or WEBP, up to 5 MB. @(Model.IsEdit ? "Leave empty to keep the current banner." : "Optional.")</div>
                        <span asp-validation-for="Banner" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary rd-btn-pill px-4">@(Model.IsEdit ? "Save changes" : "Create event")</button>
            <a class="btn btn-outline-secondary rd-btn-pill" asp-action="Events">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var input = document.getElementById('Banner');
            var preview = document.getElementById('banner-preview');
            if (!input || !preview) return;
            input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (!file) return;
                preview.src = URL.createObjectURL(file);
                preview.style.display = '';
            });
        })();
    </script>
}
